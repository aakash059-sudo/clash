  <script data-stitch-original-script="c03734eb0e11f1d6===../../images/prod_chili_crisp.jpg|||1852dd461cee99bb===../../images/prod_ramen_cup.jpg|||c03734eb0e11f1d6===../../images/prod_chili_crisp.jpg">
    let currentPack = 'Single (170g)';
    let currentUnitPrice = 8.50;
    let detailQty = 1;

    const bag = [
      { name: 'Sichuan Truffle Chili Crisp (Single)', price: 8.50, qty: 1, img: 'https://lh3.googleusercontent.com/aida/ALJJyrCMbPP-0BxWOmqKL3RWnkMhcfe3Zvu12GLZu5oj85rhsmhXJONLgqzj2K8T4Kp46BlpfNDrkm1jQN23F12wOYRo95NpE9eZSf8CTbUEAHFGAIkMn-TGW05vqC-4aNcjMzw6jnUvAK0FJ7T68OYdo0rdyMpDw2tIV9yn1PwcPMO0bK-aB4hT83DKpWZU2tZeXMAeUDZeZ0xLp4wW2Z-MgrnPtBI-4H86nuGzlgpJ8Wa9Bu6BH-usvK3PTSM' },
      { name: 'Spicy Rose Carbonara Ramen', price: 5.90, qty: 1, img: 'https://lh3.googleusercontent.com/aida/ALJJyrAMPczDxrykmkDiYKBwARN--cu4Fe7aPv5AJ6K09hxjXFAERGyNoyRbV2hXOWiUIa8LFYG9UiG7XsezyqbOOp44tMblfoCr3k7_MpgYvUBX221u4FoUX9AE39B8P4M3tOAvQoZ4GpGaEWR_Fy_I_pXt3qkZ1duPCCBGt_w9Sco3c15AWqfPsu4YwjQIbD6SGYY1MmpVXybvBNdptITKe86TBgtqAUfdBILc2bKg1cIY-gWLU-Kq2bY2sw' }
    ];

    function updateDetailCta() {
      const total = currentUnitPrice * detailQty;
      document.getElementById('detail-price').textContent = '$' + currentUnitPrice.toFixed(2);
      document.getElementById('detail-qty').textContent = detailQty;
      document.getElementById('detail-add-label').textContent = 'Add · $' + total.toFixed(2);
    }

    function selectPack(btn) {
      document.querySelectorAll('.pack-btn').forEach(el => {
        const active = el === btn;
        el.setAttribute('aria-pressed', active ? 'true' : 'false');
        el.className = active
          ? 'pack-btn flex flex-col items-start p-gutter-md rounded-lg border-2 border-light-primary bg-light-surface-container-lowest text-left transition-colors duration-state-change'
          : 'pack-btn flex flex-col items-start p-gutter-md rounded-lg border border-light-outline-variant bg-light-surface-container-lowest text-left hover:border-light-primary transition-colors duration-state-change';
      });
      currentPack = btn.dataset.pack;
      currentUnitPrice = parseFloat(btn.dataset.price);
      updateDetailCta();
    }

    function changeDetailQty(delta) {
      detailQty = Math.max(1, detailQty + delta);
      updateDetailCta();
    }

    function addCurrentProduct() {
      const label = 'Sichuan Truffle Chili Crisp (' + currentPack + ')';
      const existing = bag.find(i => i.name === label);
      if (existing) {
        existing.qty += detailQty;
      } else {
        bag.push({ name: label, price: currentUnitPrice, qty: detailQty, img: 'https://lh3.googleusercontent.com/aida/ALJJyrCMbPP-0BxWOmqKL3RWnkMhcfe3Zvu12GLZu5oj85rhsmhXJONLgqzj2K8T4Kp46BlpfNDrkm1jQN23F12wOYRo95NpE9eZSf8CTbUEAHFGAIkMn-TGW05vqC-4aNcjMzw6jnUvAK0FJ7T68OYdo0rdyMpDw2tIV9yn1PwcPMO0bK-aB4hT83DKpWZU2tZeXMAeUDZeZ0xLp4wW2Z-MgrnPtBI-4H86nuGzlgpJ8Wa9Bu6BH-usvK3PTSM' });
      }
      renderBag();
      document.getElementById('bag-drawer-overlay').classList.remove('hidden');
    }

    function renderBag() {
      const countEl = document.getElementById('bag-count-text');
      const listEl = document.getElementById('bag-items-list');
      const subtotalEl = document.getElementById('bag-subtotal');
      const checkoutLabel = document.getElementById('checkout-btn-label');

      const totalQty = bag.reduce((sum, item) => sum + item.qty, 0);
      const totalAmt = bag.reduce((sum, item) => sum + item.price * item.qty, 0);

      countEl.textContent = totalQty;
      subtotalEl.textContent = '$' + totalAmt.toFixed(2);
      checkoutLabel.textContent = 'Checkout $' + totalAmt.toFixed(2);

      if (bag.length === 0) {
        listEl.innerHTML = '<p class="font-body text-body-md text-light-on-surface-variant">Your bag is empty. Add some snacks or fresh staples!</p>';
        return;
      }

      listEl.innerHTML = bag.map((item, idx) => `
        <div class="flex items-center justify-between gap-gutter-md bg-light-surface-container-lowest border border-light-outline-variant rounded-md p-gutter-sm">
          <div class="flex items-center gap-gutter-sm">
            <img src="${item.img}" alt="${item.name}" class="w-14 h-14 rounded-sm object-cover bg-light-surface-container-low" />
            <div class="flex flex-col">
              <span class="font-body text-title-md text-light-on-surface">${item.name}</span>
              <span class="font-mono text-label-sm text-light-on-surface-variant tabular-nums">$${item.price.toFixed(2)}</span>
            </div>
          </div>
          <div class="flex items-center gap-gutter-xs">
            <button type="button" onclick="updateQty(${idx}, -1)" aria-label="Decrease quantity" class="w-8 h-8 rounded-full bg-light-surface-container text-light-on-surface font-label text-label-lg">-</button>
            <span class="font-mono text-label-lg w-6 text-center tabular-nums">${item.qty}</span>
            <button type="button" onclick="updateQty(${idx}, 1)" aria-label="Increase quantity" class="w-8 h-8 rounded-full bg-light-surface-container text-light-on-surface font-label text-label-lg">+</button>
          </div>
        </div>
      `).join('');
    }

    function addToBag(name, price, img) {
      const existing = bag.find(i => i.name === name);
      if (existing) {
        existing.qty += 1;
      } else {
        bag.push({ name, price, qty: 1, img });
      }
      renderBag();
      document.getElementById('bag-drawer-overlay').classList.remove('hidden');
    }

    function updateQty(idx, delta) {
      bag[idx].qty += delta;
      if (bag[idx].qty <= 0) bag.splice(idx, 1);
      renderBag();
    }

    document.getElementById('open-bag-btn').addEventListener('click', () => {
      renderBag();
      document.getElementById('bag-drawer-overlay').classList.remove('hidden');
    });

    document.getElementById('close-bag-btn').addEventListener('click', () => {
      document.getElementById('bag-drawer-overlay').classList.add('hidden');
    });

    renderBag();
  </script>


